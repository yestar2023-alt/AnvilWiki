---
import { Icon } from 'astro-icon/components';
import LocaleLayout from '~/components/layout/LocaleLayout.astro';
import { site } from '~/config/site';
import { type Locale } from '~/i18n/routing';
import { getUi } from '~/i18n/ui';
import { localizePath } from '~/lib/url';

interface Props {
  locale: Locale;
  jsonLd?: Record<string, unknown>[];
  alternates?: Array<{ hreflang: string; href: string }>;
}
const { locale, jsonLd = [], alternates = [] } = Astro.props;
const ui = getUi(locale);
const command = ui.command;
---

<LocaleLayout locale={locale} title={ui.home.meta.title} description={ui.home.meta.description} jsonLd={jsonLd} alternates={alternates}>
  <div class="command-shell">
    <aside class="command-rail">
      <p class="micro rail-label">{command.index}</p>
      <nav aria-label={command.index} class="rail-navigation">
        {command.navigation.map((item, index) => (
          <a href={localizePath(item.href, locale)} class:list={['rail-link', index === 0 && 'is-current']} aria-current={index === 0 ? 'page' : undefined}>
            <Icon name={item.icon} /><span>{item.label}</span><small>{item.number}</small>
          </a>
        ))}
      </nav>
      <div class="rail-external">
        <p class="micro rail-label">{command.externalLabel}</p>
        <a href={site.social.official} target="_blank" rel="noopener noreferrer"><Icon name="lucide:external-link" />{command.steamLabel}<span>↗</span></a>
        <a href={command.workshopUrl} target="_blank" rel="noopener noreferrer"><Icon name="lucide:blocks" />{command.workshopLabel}<span>↗</span></a>
        <a href={command.developerUrl} target="_blank" rel="noopener noreferrer"><Icon name="lucide:globe" />{command.developerLabel}<span>↗</span></a>
      </div>
      <div class="rail-message">
        <div class="radar-mark" aria-hidden="true"><span></span><i></i></div>
        <p>{command.railNote}<br />{command.railNoteSecond}</p><span>{command.railCaption}</span>
      </div>
      <p class="micro rail-edition">{command.edition}</p>
    </aside>

    <div class="command-content">
      <div class="command-location">
        <span><Icon name="lucide:radar" />{command.breadcrumb}<span class="location-slash">/</span><span class="location-home">{ui.nav.home}</span></span>
        <span class="micro readiness"><i></i>{command.status}</span>
      </div>

      <section class="command-hero" aria-labelledby="briefing-title">
        <img class="hero-map" src="/images/game/screenshot-1.webp" alt={command.heroAlt} width="1600" height="900" fetchpriority="high" loading="eager" />
        <div class="hero-shade" aria-hidden="true"></div>
        <span class="hero-corner corner-one" aria-hidden="true"></span><span class="hero-corner corner-two" aria-hidden="true"></span>
        <div class="hero-copy">
          <p class="micro hero-eyebrow"><span></span>{command.heroLabel}</p>
          <h1 id="briefing-title"><span class="sr-only">{command.heroGame}</span><span>{command.heroTitle}</span><strong>{command.heroAccent}</strong></h1>
          <p class="hero-description">{command.heroDescription}</p>
          <div class="hero-actions">
            <a class="command-button" href={localizePath(command.primaryHref, locale)}>{command.primary}<Icon name="lucide:arrow-up-right" /></a>
            <a class="hero-secondary" href={localizePath(command.secondaryHref, locale)}>{command.secondary}<Icon name="lucide:arrow-right" /></a>
          </div>
          <div class="hero-tags micro">{command.heroTags.map((tag) => <span>{tag}</span>)}</div>
        </div>
        <div class="hero-objective"><Icon name="lucide:focus" /><div><span class="micro">{command.objectiveLabel}</span><strong>{command.objective}</strong></div></div>
        <p class="hero-caption micro"><span></span>{command.heroCaption}</p>
      </section>

      <div class="deployment-note">
        <Icon name="lucide:triangle-alert" /><p><strong class="micro">{command.briefingLabel}</strong><span>{command.briefingText}</span></p><span class="micro note-edition">{command.earlyAccess}</span>
      </div>

      <nav class="quick-deploy" aria-label={ui.home.start.badge}>
        {command.quickLinks.map((link) => (
          <a href={localizePath(link.href, locale)}>
            <span class="quick-icon"><Icon name={link.icon} /></span><div><strong>{link.label}</strong><span>{link.detail}</span></div><small class="micro">{link.number}</small>
          </a>
        ))}
      </nav>

      <div class="command-library">
        <section class="field-guides" aria-labelledby="guides-title">
          <div class="command-section-heading">
            <div><p class="micro section-eyebrow">{command.guidesEyebrow}</p><h2 id="guides-title">{command.guidesTitle}</h2></div>
            <a href={localizePath('/guides/', locale)}>{command.allGuides}<Icon name="lucide:arrow-right" /></a>
          </div>
          <div class="field-guide-grid">
            {command.featured.map((guide, index) => (
              <a href={localizePath(guide.href, locale)} class="field-guide">
                <div class="guide-image"><img src={guide.image} alt={guide.alt} width="1600" height="900" loading="lazy" decoding="async" /><span class="guide-number micro">0{index + 1}</span><span class="guide-open"><Icon name="lucide:arrow-up-right" /></span></div>
                <div class="guide-copy"><p class:list={['micro guide-label', guide.tone === 'amber' && 'text-amber']}><Icon name={guide.icon} />{guide.label}</p><h3>{guide.title}</h3><p class="guide-description">{guide.description}</p><span class="guide-cta">{command.readGuide}<Icon name="lucide:arrow-right" /></span></div>
              </a>
            ))}
          </div>
        </section>

        <aside class="intel-column">
          <section class="commander-note">
            <p class="micro"><Icon name="lucide:notebook-pen" />{command.fieldNoteLabel}</p><h2>{command.fieldNoteTitle}</h2><p class="note-copy">{command.fieldNoteText}</p>
            <a href={localizePath('/safe-zones/', locale)}>{command.fieldNoteLink}<Icon name="lucide:arrow-up-right" /></a>
          </section>
          <section class="danger-note"><p class="micro"><Icon name="lucide:triangle-alert" />{command.dangerLabel}</p><p>{command.dangerText}</p></section>
          <section class="game-intel">
            <p class="micro section-eyebrow">{command.intelLabel}</p><h2>{command.intelTitle}</h2>
            <dl>{command.facts.map((fact) => <div><dt class="micro">{fact.label}</dt><dd>{fact.value}</dd></div>)}</dl>
            <a href={localizePath('/guides/system-requirements/', locale)}><Icon name="lucide:monitor" />{command.requirementsLabel}<Icon name="lucide:arrow-up-right" /></a>
          </section>
          <div class="intel-review"><Icon name="lucide:scan-line" /><p class="micro">{command.verified}</p><span>{command.earlyAccessText}</span></div>
        </aside>
      </div>

      <section class="force-section" aria-labelledby="forces-title">
        <div class="command-section-heading"><div><p class="micro section-eyebrow">{command.referenceLabel}</p><h2 id="forces-title">{command.referenceTitle}</h2></div><a href={localizePath('/items/', locale)}>{command.referenceLink}<Icon name="lucide:arrow-right" /></a></div>
        <div class="force-grid">{command.forces.map((force) => (
          <a href={localizePath(force.href, locale)} class="force-card"><Icon name={force.icon} class="force-symbol" /><span class="micro">{force.code}</span><h3>{force.title}</h3><p>{force.description}</p><Icon name="lucide:arrow-up-right" class="force-arrow" /></a>
        ))}</div>
      </section>

      <section class="next-move">
        <img src="/logo.svg" alt="" width="80" height="80" loading="lazy" /><div><p class="micro section-eyebrow">{command.bottomLabel}</p><h2>{command.bottomTitle}</h2><p>{command.bottomText}</p></div>
        <a class="command-button" href={localizePath(command.primaryHref, locale)}>{command.primary}<Icon name="lucide:arrow-up-right" /></a>
      </section>
      <p class="screenshot-credit">{command.imageCredit}</p>
    </div>
  </div>
</LocaleLayout>
